{
  "name": "interface-auto-builder",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts",
    "dev:ui": "vite --host 127.0.0.1",
    "start": "node dist-service/server.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "build": "tsc --noEmit && vite build && node scripts/build-service.mjs",
    "preview": "node dist-service/server.mjs",
    "predev": "node scripts/build-service.mjs",
    "verify:delivery": "tsx scripts/verify-delivery.ts",
    "pretest": "node scripts/build-service.mjs"
  },
  "dependencies": {
    "esbuild": "^0.28.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^10.12.0",
    "globals": "^16.4.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.0.0"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "engines": {
    "node": ">=22.16.0"
  }
}
